@page
@model ManagementPanel.Pages.Account.ActivateModel

@{
    Layout = "_layout";
    ViewData["Title"] = "تأیید ایمیل";
}

@section Styles {
    <style>
        .activation-wrapper {
            min-height: 75vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
            direction: rtl;
        }

        .activation-card {
            width: 100%;
            max-width: 500px;
            background: #fff;
            padding: 45px 35px;
            border-radius: 16px;
            text-align: center;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }

        .activation-icon {
            width: 85px;
            height: 85px;
            margin: 0 auto 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #dcfce7;
            color: #16a34a;
            border-radius: 50%;
            font-size: 38px;
        }

        .activation-card h2 {
            color: #1e293b;
            font-size: 23px;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .activation-card p {
            color: #64748b;
            font-size: 15px;
            line-height: 2;
            margin-bottom: 25px;
        }

        .activation-btn {
            display: inline-block;
            background: #2563eb;
            color: #fff;
            text-decoration: none;
            padding: 11px 35px;
            border-radius: 10px;
            font-size: 14px;
            transition: background 0.2s;
        }

        .activation-btn:hover {
            background: #1d4ed8;
            color: #fff;
        }

        @@media (max-width: 576px) {
            .activation-card {
                padding: 35px 22px;
            }

            .activation-card h2 {
                font-size: 20px;
            }
        }
    </style>
}

<div class="activation-wrapper">
    <div class="activation-card">

        <div class="activation-icon">
            ✓
        </div>

        <h2>ایمیل شما با موفقیت تأیید شد!</h2>

        <p>
            حساب کاربری شما فعال شده است.
            اکنون می‌توانید با استفاده از اطلاعات حساب خود وارد سیستم شوید.
        </p>

        <a asp-page="/Account/Login" class="activation-btn">
            ورود به حساب کاربری
        </a>

    </div>
</div>